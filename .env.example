# Web command center
PORT=3000
REMOTE_PIN=2468

# One OBS computer (default)
OBS_NAME=Mac mini OBS
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# Optional AI assistant. Keep the API key ONLY in your local .env file.
# Create an API key in the OpenAI developer platform, then uncomment these lines.
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-5-mini

# Optional: control multiple OBS computers instead of the single values above.
# Keep this on ONE line and remove the leading #.
# OBS_TARGETS_JSON=[{"id":"mac-mini","name":"Mac mini OBS","url":"ws://127.0.0.1:4455","password":"password-one"},{"id":"studio","name":"Studio PC","url":"ws://192.168.1.50:4455","password":"password-two"}]
